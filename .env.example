# Environment variables used by the FitLingo backend.
#
# Per security policy, secret VALUES are never written to any file — not even
# placeholders in this template. This file only DOCUMENTS which variables the
# app reads. Provide the values via:
#   - Production: the Render dashboard → your backend service → Environment tab
#   - Local dev: inject into the shell at launch from the OS secret store
#     (e.g. `OPENAI_API_KEY="$(security find-generic-password -s openai -w)" npm run dev`)
#
# --- Database ---
#   DATABASE_URL      preferred: full Postgres connection string (contains the password — treat as secret)
#   or discrete vars: DB_HOST, DB_PORT, DB_NAME, DB_USER + secret DB_PASSWORD
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sportlingo
DB_USER=postgres
#   DB_PASSWORD       secret — inject at launch, do not write here
#
# --- Auth ---
#   JWT_SECRET        secret — long random string, inject at launch
JWT_EXPIRY=7d
#
# --- CORS ---
# Comma-separated allowed origins (the Vercel frontend URL in production)
CORS_ORIGIN=http://localhost:3000
#
# --- Email (Resend) ---
#   RESEND_API_KEY    secret — inject at launch; when unset, emails are logged to console instead
EMAIL_FROM=FitLingo <onboarding@resend.dev>
#
# --- OpenAI (AI-personalized plans + dynamic onboarding questions) ---
#   OPENAI_API_KEY    secret — inject at launch / set on Render; when unset, the
#                     app gracefully falls back to the static starter path
# Optional non-secret overrides:
# OPENAI_MODEL=gpt-5-mini
# OPENAI_TIMEOUT_MS=30000
#
# --- Frontend (set as a build-time env var on Vercel) ---
# REACT_APP_API_URL=https://your-backend.onrender.com/api

# Docker Compose reads variables from a root .env file.
# Copy this file to .env and fill the email values to enable real emails.

EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=FitLingo <your_email@gmail.com>

# Optional custom SMTP instead of EMAIL_SERVICE
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportlingo
DB_USER=sportlingo_user
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRY=7d

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=FitLingo <your_email@gmail.com>

# Optional custom SMTP instead of EMAIL_SERVICE
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
